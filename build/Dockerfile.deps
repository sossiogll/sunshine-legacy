# Ambiente di build di Sunshine (senza CUDA) su Ubuntu 24.04: solo le dipendenze.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /build/sunshine/
COPY scripts/linux_build.sh ./scripts/linux_build.sh
COPY packaging/linux/patches/ ./packaging/linux/patches/
RUN chmod +x ./scripts/linux_build.sh \
    && ./scripts/linux_build.sh --step=deps --skip-cuda --sudo-off \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
